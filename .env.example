# ============================================================
# AccessLearn AI - Environment Configuration (Phase 1)
# ============================================================

# Backend Settings
DATABASE_URL=postgresql://accesslearn:accesslearn_secure_pass@localhost:5432/accesslearn_db
REDIS_URL=redis://localhost:6379/0

# JWT & Security
JWT_SECRET=super_secret_jwt_signing_key_change_in_production_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=50

# Allowed File Extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,docx,pptx,png,jpg,jpeg,txt,mp3,wav,mp4

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery Worker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Future Provider Stubs (Not required for Phase 1 execution)
# LLM_PROVIDER=mock
# OCR_PROVIDER=mock
# STT_PROVIDER=mock
# TTS_PROVIDER=mock

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
